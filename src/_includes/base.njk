<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{ title }} · Natalie Taylor</title>
  <meta name="description" content="{{ description or 'Content designer and copywriter - marketing, ecommerce and content strategy portfolio.' }}">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Nunito:ital,wght@0,300;0,400;0,600;0,700;1,300;1,400&family=Playfair+Display:ital,wght@0,600;0,700;1,600&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="{{ '/css/style.css' | url }}">
</head>
<body>
  <header class="site-header">
    <a class="site-title" href="{{ '/' | url }}">Natalie Taylor</a>
    <input type="checkbox" id="nav-toggle" class="nav-toggle-checkbox">
    <label for="nav-toggle" class="nav-toggle-label" aria-label="Toggle navigation">
      <span></span>
      <span></span>
      <span></span>
    </label>
    <nav class="site-nav">
      <div class="nav-item">
        <a href="{{ '/case-studies/' | url }}">Case Studies</a>
        <ul class="nav-dropdown">
          {% for item in collections.caseStudies %}
          <li><a href="{{ item.url | url }}">{{ item.data.title }}</a></li>
          {% endfor %}
        </ul>
      </div>
      <div class="nav-item">
        <a href="{{ '/copywriting/' | url }}">Copywriting</a>
        <ul class="nav-dropdown">
          {% for item in collections.copySamples %}
          <li><a href="{{ item.url | url }}">{{ item.data.title }}</a></li>
          {% endfor %}
        </ul>
      </div>
      <a href="{{ '/about/' | url }}">About</a>
      <a href="https://www.linkedin.com/in/natataylor/" target="_blank" rel="noopener">Find me on LinkedIn</a>
    </nav>
  </header>

  <main class="site-main">
    {{ content | safe }}

    {% if tags and "case-study" in tags %}
    <div class="more-case-studies">
      <h2 class="case-section-heading">Read More Case Studies</h2>
      <div class="case-carousel">
        {% for item in collections.caseStudies %}
          {% if item.url != page.url %}
          <a class="featured-card" href="{{ item.url | url }}">
            <img src="{{ item.data.cardImage | url }}" alt="{{ item.data.cardAlt }}" style="object-position: {{ item.data.cardPosition | default('center') }};">
            <span class="featured-card-title">{{ item.data.title }}</span>
            <span class="featured-card-skills"><span class="eyebrow-label">Skills employed:</span>{{ item.data.skills }}</span>
          </a>
          {% endif %}
        {% endfor %}
      </div>
    </div>
    {% endif %}

    {% if tags and "copy-sample" in tags %}
    <div class="more-case-studies">
      <h2 class="case-section-heading">See More Copywriting Examples</h2>
      <div class="case-carousel">
        {% for item in collections.copySamples %}
          {% if item.url != page.url %}
          <a class="featured-card" href="{{ item.url | url }}">
            <img src="{{ item.data.cardImage | url }}" alt="{{ item.data.cardAlt }}" style="object-position: {{ item.data.cardPosition | default('center') }};">
            <span class="featured-card-title">{{ item.data.title }}</span>
            <span class="featured-card-skills"><span class="eyebrow-label">Skills employed:</span>{{ item.data.skills }}</span>
          </a>
          {% endif %}
        {% endfor %}
      </div>
    </div>
    {% endif %}
  </main>

  <footer class="site-footer">
    <p>&copy; {% year %} Natalie Taylor &middot; <a href="https://www.linkedin.com/in/natataylor/" target="_blank" rel="noopener">LinkedIn</a></p>
  </footer>
</body>
</html>
